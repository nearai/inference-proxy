{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "admission"],
  "properties": {
    "schema_version": {
      "enum": [1]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_inflight", "backpressure_secs", "retry_after_secs"],
      "properties": {
        "max_inflight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "backpressure_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "retry_after_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    }
  }
}
